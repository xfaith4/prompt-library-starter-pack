{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prompt Library: Install All (VS Code + Claude Code)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Prompt Library: Install to VS Code (Copilot)",
        "Prompt Library: Install to Claude Code"
      ],
      "problemMatcher": []
    },
    {
      "label": "Prompt Library: Install to VS Code (Copilot)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./tools/Install-VSCode-Prompts.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Prompt Library: Sync to VS Code (Prune Stale)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./tools/Install-VSCode-Prompts.ps1",
        "-PruneStale"
      ],
      "problemMatcher": []
    },
    {
      "label": "Prompt Library: Install to Claude Code",
